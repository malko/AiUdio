# Copy this file to .env and adjust the values.
# `docker compose` reads the .env file at the repository root automatically.

# --- Ports published on the host (LAN access) ---
PORT=8004
STT_PORT=8080

# --- Hugging Face (TTS model downloads) ---
# Optional token (useful for rate limits or private models)
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# --- TTS models (override config.yaml) ---
# TTS_CUSTOM_VOICE=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# TTS_VOICE_DESIGN=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# TTS_BASE=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# --- STT (official NeMo-Speech.cpp NGC image, CUDA, multi-arch) ---
# Models are downloaded on demand from the UI; pin a specific tag or digest if needed.
STT_IMAGE=nvcr.io/nvidia/nemo-speech.cpp:0.2.0
# Optional: host directory for STT models (bind mount). Leave unset to share the
# 'hf_cache' named volume with the TTS Hugging Face cache.
# STT_MODELS_DIR=./stt_models
# Model cache directory inside the container (default points at the shared volume).
# NEMO_SPEECH_MODEL_DIR=/hf_cache/nemo-speech/models

# --- TTS build overrides (optional; defaults target CUDA 13) ---
# TTS_BASE_IMAGE=pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
# TTS_TORCH_SPEC=                      # empty = keep the base image's torch/torchaudio
# TTS_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# INSTALL_CHATTERBOX=1                 # build the isolated Chatterbox venv (/opt/cb/venv)
# Chatterbox package (PyPI 0.1.7 = multilingual v2 only; git = V3). Pin a commit for reproducibility.
# CHATTERBOX_SPEC=git+https://github.com/resemble-ai/chatterbox.git
# The Chatterbox venv reuses the base image's CUDA 13 torch (chatterbox pins torch 2.6 /
# CUDA 12.4, which has no kernels for newer GPUs like Blackwell/RTX 50xx).

# --- TTS engine behaviour ---
# Global engine used to synthesize cloned avatars: qwen3 (default) or chatterbox.
# TTS_CLONE_BACKEND=qwen3
# Interpreter of the isolated Chatterbox venv (auto-detected; /opt/cb/venv/bin/python).
# TTS_CHATTERBOX_PYTHON=/opt/cb/venv/bin/python

# --- Non-NVIDIA hardware (additive overrides, one CUDA default remains) ---
#   docker compose -f docker-compose.yml -f docker-compose.rocm.yml   up -d --build
#   docker compose -f docker-compose.yml -f docker-compose.cpu.yml    up -d --build
#   docker compose -f docker-compose.yml -f docker-compose.vulkan.yml up -d --build
# The non-NVIDIA overrides build NeMo-Speech.cpp from source; pick the upstream ref here:
# NEMO_SPEECH_REF=main

# --- External LLM (OpenAI-compatible, e.g. llama.cpp / Ollama / vLLM) ---
# The LLM is NOT served by this compose stack.
# NOTE: leave these UNSET to manage the LLM from the UI (Settings tab). Setting them
# here overrides the value saved by the UI on every restart.
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- Security ---
# Enable API/UI authentication (recommended when the network is not fully trusted).
# Leave UNSET to keep the value persisted in config.yaml.
# AUTH_ENABLED=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=
# API keys are created/revoked from the admin UI (Settings -> Access & API keys);
# they are stored hashed and are not set here.
