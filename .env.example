# Copy this file to .env and adjust the values.
# `docker compose` reads the .env file at the repository root automatically.

# --- Port published on the host (LAN access) ---
PORT=8004
STT_PORT=8080

# --- Hugging Face ---
# Optional token (useful for rate limits or private models)
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# --- TTS models (override config.yaml) ---
# TTS_CUSTOM_VOICE=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# TTS_VOICE_DESIGN=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# TTS_BASE=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# --- STT (NeMo-Speech.cpp) ---
# High-accuracy offline ASR model (Parakeet TDT v3) or streaming model (Nemotron 3.5)
STT_ASR_MODEL=nemotron-3.5
# Optional: host directory for STT GGUF models (bind mount). Leave unset to share the
# 'hf_cache' named volume with the TTS Hugging Face cache (STT files live under
# nemo-speech/models inside it).
# STT_MODELS_DIR=./stt_models
# STT ggml backend: cuda (default), cpu or vulkan. Independent from the TTS backend,
# so you can mix them (e.g. CUDA TTS + CPU STT) — see "Mixing backends" in the README.
STT_BACKEND=cuda
# Upstream NeMo-Speech.cpp branch/tag to build from
NEMO_SPEECH_REF=main
# Where NeMo-Speech.cpp downloads/caches models inside the container. Defaults to the
# shared volume subdirectory. Local model paths and cached models live here.
# NEMO_SPEECH_MODEL_DIR=/hf_cache/nemo-speech/models
# Path to the model catalog (maps "nemotron-3.5" -> HF repo + checksum). Shipped in the
# image; override only if you provide your own index (e.g. an offline copy in the volume).
# NEMO_SPEECH_MODEL_INDEX=/usr/local/share/nemo-speech/model-index.json
# Path to the model catalog (maps "nemotron-3.5" -> HF repo + checksum). Shipped in the
# image; override only if you provide your own index (e.g. an offline copy in the volume).
# NEMO_SPEECH_MODEL_INDEX=/usr/local/share/nemo-speech/model-index.json

# --- TTS build overrides (optional; defaults target CUDA 12.4) ---
# For CUDA 13 use docker-compose.cuda13.yml, or set these directly:
# TTS_DOCKERFILE=docker/tts.Dockerfile
# TTS_BASE_IMAGE=pytorch/pytorch:2.14.1-cuda13.2-cudnn9-runtime
# TTS_TORCH_SPEC=                      # empty = keep the base image's torch
# TTS_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu132
#
# STT CUDA base images. Defaults: CUDA 13.4 on Ubuntu 26.04 (requires driver >= 580,
# and a recent CMake for the NeMo-Speech.cpp build). For older drivers use the
# docker-compose.cuda12.yml override, or set these to CUDA 12.8 / Ubuntu 24.04:
# STT_CUDA_BUILDER_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
# STT_CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04
# STT CUDA architectures. Empty = broad portable default
# ("75;80;86;89;90;100;120"). Set to your GPU to build faster/smaller, e.g.
# 75 Turing, 80/86 Ampere, 89 Ada/RTX 40, 90 Hopper, 100 Blackwell DC, 120 Blackwell/RTX 50.
# STT_CUDA_ARCHITECTURES=89

# --- External LLM (OpenAI-compatible, e.g. llama.cpp / Ollama / vLLM) ---
# The LLM is NOT served by this compose stack.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=
LLM_MODEL=

# --- Security ---
# Enable API/UI authentication (recommended when the network is not fully trusted)
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_API_KEYS=
