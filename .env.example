# Copy this file to .env and adjust the values.
# `docker compose` reads the .env file at the repository root automatically.

# --- Port published on the host (LAN access) ---
PORT=8004
STT_PORT=8080

# --- Hugging Face ---
# Optional token (useful for rate limits or private models)
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# --- TTS models (override config.yaml) ---
# TTS_CUSTOM_VOICE=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# TTS_VOICE_DESIGN=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# TTS_BASE=Qwen/Qwen3-TTS-12Hz-1.7B-Base

# --- STT (NeMo-Speech.cpp) ---
# High-accuracy offline ASR model (Parakeet TDT v3) or streaming model (Nemotron 3.5)
STT_ASR_MODEL=nemotron-3.5
# Host directory holding the GGUF models mounted into the STT container
STT_MODELS_DIR=./stt_models

# --- External LLM (OpenAI-compatible, e.g. llama.cpp / Ollama / vLLM) ---
# The LLM is NOT served by this compose stack.
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=
LLM_MODEL=

# --- Security ---
# Enable API/UI authentication (recommended when the network is not fully trusted)
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_API_KEYS=
